# .claude : seuls les agents de l'agence SEO et le skill de design sont versionnés
/.claude/*
!/.claude/agents/
!/.claude/skills/
/.claude/skills/*
!/.claude/skills/msd-design-system/
/node_modules
/.env.analytics

# SEO audit outputs
/FULL-AUDIT-REPORT.md
/ACTION-PLAN.md
/seo-reports/

# Claude SEO skill
/skills/

# Cerveau SEO privé — jamais push, jamais déployé
/msd-media-seo/

# Artefact de build régénéré à chaque `npm run blog:build`
/scripts/generate-blog.cjs

# Vercel CLI local
/.vercel

# Link graph data (regenerated by `npm run link-graph`, private tool)
/scripts/.link-graph-data.json

# Logs
npm-debug.log*
*.log
.vercel
.env*

# Skills installés localement (npx skills add)
/.agents/
/skills-lock.json
