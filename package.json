{
  "name": "msd-website",
  "private": true,
  "type": "module",
  "scripts": {
    "assets:build": "node scripts/version-assets.mjs",
    "seo:check": "python3 scripts/check-seo.py && node scripts/version-assets.mjs --check && node scripts/check-retraits.mjs",
    "seo:browser-check": "node scripts/check-browser.mjs && node scripts/check-conversions.mjs",
    "seo:prepare": "npm run blog:build && node scripts/update-lastmod.mjs && npm run seo:check",
    "seo:sync-faq": "python3 scripts/check-seo.py --sync-faq",
    "blog:build": "cp scripts/generate-blog.js scripts/generate-blog.cjs && node scripts/generate-blog.cjs && node scripts/version-assets.mjs",
    "index:submit": "node scripts/google-index.mjs --days=7",
    "index:dry-run": "node scripts/google-index.mjs --days=7 --dry-run",
    "lastmod:update": "node scripts/update-lastmod.mjs",
    "lastmod:dry-run": "node scripts/update-lastmod.mjs --dry-run",
    "uptime:check": "node scripts/uptime-monitor.mjs",
    "link-graph": "node scripts/link-graph.mjs",
    "hooks:setup": "git config core.hooksPath .githooks && echo 'Hooks installés ✓'",
    "years:check": "node scripts/check-years.mjs",
    "assets:version": "node scripts/version-assets.mjs",
    "theme:light": "node scripts/build-light-theme.mjs && node scripts/version-assets.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "google-auth-library": "^9.15.1",
    "nodemailer": "^6.10.1",
    "playwright": "^1.55.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postcss": "^8.5.32"
  }
}
